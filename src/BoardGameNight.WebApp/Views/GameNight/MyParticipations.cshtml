@model IEnumerable<GameNightListDto>
@{
    ViewData["Title"] = "Mijn Deelnames";
}

<h1><i class="bi bi-person-check me-2"></i>Mijn Deelnames</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Je neemt nog niet deel aan bordspellenavonden. <a asp-action="Index">Bekijk alle avonden</a></div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead class="table-primary">
                <tr><th>Datum</th><th>Tijd</th><th>Stad</th><th>Organisator</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var gn in Model)
                {
                    <tr>
                        <td>@gn.DateTime.ToString("dd-MM-yyyy")</td>
                        <td>@gn.DateTime.ToString("HH:mm")</td>
                        <td>@gn.City</td>
                        <td>@gn.OrganizerName</td>
                        <td>
                            @if (gn.DateTime < DateTime.Now) { <span class="badge bg-secondary">Afgelopen</span> }
                            else { <span class="badge bg-success">Aankomend</span> }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@gn.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
