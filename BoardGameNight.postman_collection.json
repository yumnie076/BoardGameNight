		{
			"key": "baseUrl",
			"value": "https://localhost:7001",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "gameNightId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "personId",
			"value": "1",
			"type": "string"
		}
	],
